{
  "name": "casm",
  "displayName": "CASM \u2014 Architecture as Code",
  "description": "Completion, validation, hover, and quick-fixes for CASM architecture files.",
  "version": "0.3.0",
  "publisher": "casimirex",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/casimirex/casm.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "architecture",
    "architecture-as-code",
    "casm",
    "c4"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/architecture.yaml",
    "workspaceContains:**/*.casm.yaml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "casm",
        "aliases": [
          "CASM Architecture",
          "casm"
        ],
        "extensions": [
          ".casm.yaml",
          ".casm.yml"
        ],
        "filenames": [
          "architecture.yaml",
          "architecture.yml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "casm",
        "scopeName": "source.casm",
        "path": "./syntaxes/casm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "casm.generateDiagram",
        "title": "Generate Mermaid diagram",
        "category": "CASM"
      },
      {
        "command": "casm.validateWorkspace",
        "title": "Validate every open architecture",
        "category": "CASM"
      },
      {
        "command": "casm.reloadPatterns",
        "title": "Reload the pattern library",
        "category": "CASM"
      },
      {
        "command": "casm.restartServer",
        "title": "Restart the language server",
        "category": "CASM"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "casm.generateDiagram",
          "when": "editorLangId == casm",
          "group": "casm"
        }
      ]
    },
    "configuration": {
      "title": "CASM",
      "properties": {
        "casm.server.path": {
          "type": "string",
          "default": "casm-lsp",
          "markdownDescription": "Path to the `casm-lsp` executable. Leave as the default to use whatever is on `PATH`."
        },
        "casm.patterns": {
          "type": "string",
          "default": "",
          "markdownDescription": "Directory holding the pattern library, absolute or relative to the first workspace folder. Leave empty to look for `patterns/` and then `.casm/patterns/`. A conformance claim is reported as *unchecked* when no library holds the pattern it names."
        },
        "casm.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between VS Code and the language server. Use 'verbose' when reporting a bug."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
