# Secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key

# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Editors and local tooling
.idea/
.vscode/
.claude/
*.swp
.DS_Store

# VS Code extension build artefacts
node_modules/
editors/vscode/out/
*.vsix

# WebAssembly build output (regenerate with scripts/build-wasm.sh)
/dist
/web/pkg
/edge/casm_wasm.js
/edge/casm_wasm_bg.wasm

# Fuzzing: the seed corpus is committed, the grown corpus and artifacts are not.
/fuzz/corpus
/fuzz/artifacts
/fuzz/target

# Built documentation
/docs/book/book

# CASIMIR generated output
/out
*.casm.gen/
