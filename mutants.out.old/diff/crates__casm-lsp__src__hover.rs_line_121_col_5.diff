 /// Renders a vocabulary term, or says plainly that it is not one.
 fn describe_term(terms: &[Term], label: &str, what: &str) -> String {
     find(terms, label).map_or_else(
         || format!("`{label}` is not a recognised {what}."),
         Term::to_markdown,
     )
