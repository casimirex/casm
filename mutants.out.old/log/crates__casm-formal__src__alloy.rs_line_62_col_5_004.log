/*
 * Generated by CASIMIR from 'checkout' v1.0.0.
 * Source fingerprint: 62a2af8b556ee4e4
 *
 * Models the STATIC STRUCTURE of an architecture. Alloy has no
 * notion of time; failure and recovery are in the TLA+ module.
 *
 * 'blocks' means the source cannot serve while the target is
 * unavailable. 'notifies' is asynchronous and carries no such
 * dependency -- which is what a queue between two services buys.
 *
 * Regenerate with:  casm formal --format alloy
 */
module checkout

// Identifier mapping, for reading counterexamples back:

abstract sig Node {
    blocks:   set Node,   // cannot serve while the target is down
    notifies: set Node    // asynchronous; no availability dependency
}

sig Database, Gateway, Human, Queue, Service extends Node {}

one sig N_unknown extends Human {}
one sig N_unknown extends Queue {}
one sig N_unknown extends Gateway {}
one sig N_unknown extends Service {}
one sig N_unknown extends Database {}

fact Topology {
    N_unknown.blocks = N_unknown
    N_unknown.notifies = none
    N_unknown.blocks = none
    N_unknown.notifies = none
    N_unknown.blocks = N_unknown
    N_unknown.notifies = none
    N_unknown.blocks = N_unknown
    N_unknown.notifies = N_unknown
    N_unknown.blocks = none
    N_unknown.notifies = none
}

// Nodes outside the control boundary.
fun External: set Node { N_unknown }

// Nodes holding state that survives a restart.
fun Stateful: set Node { N_unknown + N_unknown }

// No node depends on itself, however indirectly. Restates the
// 'no-dependency-cycles' rule; a counterexample names the ring.
assert NoBlockingCycles {
    no n: Node | n in n.^blocks
}
check NoBlockingCycles for 5

// Nothing outside the control boundary reaches a datastore
// directly. Restates 'no-publicly-exposed-datastores'.
assert NoDirectExternalAccessToState {
    no e: External, d: Stateful | d in e.blocks
}
check NoDirectExternalAccessToState for 5

// Every node participates in the architecture somehow.
// Restates 'no-isolated-nodes'.
assert NoIsolatedNodes {
    all n: Node |
        some n.blocks + blocks.n + n.notifies + notifies.n
}
check NoIsolatedNodes for 5

// A node behind an asynchronous boundary cannot be reached by
// following blocking edges. This is the property a queue is FOR.
assert AsyncBoundariesHold {
    all n: Node | no (n.notifies & n.^blocks)
}
check AsyncBoundariesHold for 5


