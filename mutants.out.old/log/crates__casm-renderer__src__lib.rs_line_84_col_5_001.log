 /// Resolves a node's diagram identifier.
 fn diagram_id(ids: &[(NodeId, String)], node: NodeId) -> &str {
     ids.iter()
         .find(|(id, _)| *id == node)
         .map_or("unknown", |(_, diagram_id)| diagram_id.as_str())
 }


